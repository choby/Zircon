@attribute [Authorize]
@implements IAsyncDisposable
@inject GameDataSessionService DataSession
@inject GameDataViewCatalog ViewCatalog
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGameServerController GameServer
@inject IJSRuntime JS
@inject DialogService DialogService

<PageTitle>@View.Title · Zircon</PageTitle>

<div class="page-heading compact game-data-heading">
    <div>
        <span class="eyebrow">游戏数据 / @View.Category</span>
        <h1>@View.Title</h1>
        <p>@View.Description</p>
    </div>
    <div class="view-origin"><span>原管理界面</span><strong>@LegacyViewName</strong></div>
</div>

@if (View.Tables.Count > 1)
{
    <div class="entity-switcher view-tabs" role="tablist" aria-label="数据类型">
        @foreach (GameDataTableDefinition candidate in View.Tables)
        {
            <button class="@(candidate == Table ? "active" : null)" role="tab" aria-selected="@(candidate == Table)"
                    @onclick="() => SelectTable(candidate)">@candidate.Title</button>
        }
    </div>
}



<section class="legacy-grid-shell">


    <RadzenDataGrid @key="Table.Key" @ref="Grid" TItem="object" Data="@Rows" AllowPaging="true" PageSize="30"
                    AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                    AllowColumnResize="true" AllowColumnReorder="true" 
                    EditMode="DataGridEditMode.Single" RowCreate="CreateRow" RowUpdate="UpdateRow"
                    RowRender="RenderRow"
                    Density="Density.Compact" EmptyText="暂无数据" SelectionMode="DataGridSelectionMode.Multiple"
                    ShowPagingSummary="true" PagingSummaryFormat="第 {0}–{1} 条，共 {2} 条"
                    FilterText="筛选" ApplyFilterText="应用" ClearFilterText="清除" AndOperatorText="并且" OrOperatorText="或者"
                    EqualsText="等于" NotEqualsText="不等于" LessThanText="小于" LessThanOrEqualsText="小于或等于"
                    GreaterThanText="大于" GreaterThanOrEqualsText="大于或等于" ContainsText="包含"
                    DoesNotContainText="不包含" StartsWithText="开头是" EndsWithText="结尾是"
                    IsNullText="为空" IsNotNullText="不为空" IsEmptyText="空字符串" IsNotEmptyText="非空字符串"
                    FirstPageTitle="首页" FirstPageAriaLabel="转到首页" PrevPageTitle="上一页" PrevPageAriaLabel="转到上一页"
                    NextPageTitle="下一页" NextPageAriaLabel="转到下一页" LastPageTitle="末页" LastPageAriaLabel="转到末页"
                    PageTitleFormat="第 {0} 页" PageAriaLabelFormat="转到第 {0} 页"
                    PagerHorizontalAlign="HorizontalAlign.Left" PagerInputSize="InputSize.Small">
        <Template Context="parent">
            @if (Table.Relations.Count > 0 && parent is MirDB.DBObject parentObject)
            {
                GameDataRelationDefinition selectedRelation = GetSelectedRelation(parentObject.Index);
                <div class="hierarchy-detail-panel">
                    @if (Table.Relations.Count > 1)
                    {
                        <div class="entity-switcher hierarchy-relation-tabs" role="tablist" aria-label="@($"{parentObject} 的关联数据")">
                            @foreach (GameDataRelationDefinition candidate in Table.Relations)
                            {
                                <button class="@(candidate == selectedRelation ? "active" : null)" role="tab"
                                        aria-selected="@(candidate == selectedRelation)"
                                        @onclick="() => SelectRelation(parentObject.Index, candidate)"
                                        @onclick:stopPropagation="true">@candidate.Title</button>
                            }
                        </div>
                    }
                    <GameDataRelationGrid @key="(Table.Key, parentObject.Index, selectedRelation.Property)"
                                          ParentType="@Table.ModelType" ParentIndex="@parentObject.Index"
                                          Relation="@selectedRelation" />
                </div>
            }
        </Template>
        <HeaderTemplate>
            <div class="radzen-grid-toolbar">
                <RadzenButton Size="ButtonSize.Small" Text="新增" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="AddRow"/>
                <RadzenButton Size="ButtonSize.Small" Text="刷新" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="Reload"/>
                <RadzenButton Size="ButtonSize.Small" Text="保存数据库" Icon="save" ButtonStyle="ButtonStyle.Light" Click="SaveDatabase"/>
                <RadzenButton Size="ButtonSize.Small" Text="在选中行后插入" Icon="playlist_add" ButtonStyle="ButtonStyle.Light" Click="InsertAfter"
                              Disabled="@(SelectedItems.Count != 1 || GameServer.State != GameServerState.Stopped)"/>
                <RadzenButton Size="ButtonSize.Small" Text="导出选中" Icon="download" ButtonStyle="ButtonStyle.Light" Click="ExportSelected" Disabled="@(SelectedItems.Count == 0)"/>
                <RadzenButton Size="ButtonSize.Small" Text="导出全部" Icon="file_download" ButtonStyle="ButtonStyle.Light" Click="ExportAll"/>
                <label class="file-action radzen-file-action">
                    <RadzenIcon Icon="upload_file"/>
                    导入 JSON
                    <InputFile OnChange="Import" accept="application/json,.json"/>
                </label>
                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <span class="alert @(HasError ? "danger" : "success")" role="status">@Message</span>
                }
            </div>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="object" Width="40px" Reorderable="false" Filterable="false" Sortable="false" Frozen="true">
                <HeaderTemplate>
                    <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "选择全部记录" }})"
                                    Value="@(SelectedItems.Any() != true ? false : !Rows.All(i => SelectedItems.Contains(i)) ? null : Rows.Any(i => SelectedItems.Contains(i)))"
                                    Change="@(args => SelectedItems = args == true ? Rows.ToList() : [])" />
                </HeaderTemplate>
                <Template Context="item">
                    <RadzenCheckBox TValue="bool" Value="@SelectedItems.Contains(item)" Change="@(_ => ToggleSelection(item))"
                                    Class="grid-selection-checkbox" @onclick:stopPropagation="true"/>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="object" Property="Index" Type="typeof(int)" Title="序号" Width="50px" Reorderable="false" Filterable="false" Sortable="false" Frozen="true"/>
            @foreach (GameDataColumnDefinition column in Table.Columns)
            {
                Type fieldType = GetFieldType(column.Field);
                bool isReference = typeof(MirDB.DBObject).IsAssignableFrom(fieldType);
                bool isEnum = (Nullable.GetUnderlyingType(fieldType) ?? fieldType).IsEnum;
                @if (isReference)
                {
                    <RadzenDataGridColumn TItem="object" Property="@column.Field" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)">
                        <Template Context="cell">
                            @FormatReference(cell, column.Field)
                        </Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataReferenceEditor Item="@editItem" Field="@column.Field" ReferenceType="@fieldType"/>
                            }
                            else
                            {
                                @FormatReference(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
                else if (isEnum)
                {
                    Type enumType = Nullable.GetUnderlyingType(fieldType) ?? fieldType;
                    <RadzenDataGridColumn TItem="object" Property="@column.Field" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)" Filterable="false">
                        <Template Context="cell">@GetDisplayValue(cell, column.Field)</Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataEnumEditor Item="@editItem" Field="@column.Field" EnumType="@enumType"/>
                            }
                            else
                            {
                                @GetDisplayValue(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
                else
                {
                    <RadzenDataGridColumn TItem="object" Property="@column.Field" Type="@fieldType" Title="@column.Title" Width="@ColumnWidth(column, fieldType)">
                        <Template Context="cell">@GetDisplayValue(cell, column.Field)</Template>
                        <EditTemplate Context="editItem">
                            @if (column.Editable && IsEditable(column.Field, fieldType))
                            {
                                <GameDataValueEditor Item="@editItem" Field="@column.Field" ValueType="@fieldType"/>
                            }
                            else
                            {
                                @GetDisplayValue(editItem, column.Field)
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            }
            <RadzenDataGridColumn TItem="object" Title="操作" Width="82px" Filterable="false" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                <Template Context="item">
                    <div class="grid-row-actions">
                        <RadzenButton Icon="edit" title="编辑" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => EditRow(item))" @onclick:stopPropagation="true"/>
                        <RadzenButton Icon="delete" title="删除" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteRow(item))" @onclick:stopPropagation="true"/>
                    </div>
                </Template>
                <EditTemplate Context="item">
                    <div class="grid-row-actions">
                        <RadzenButton Icon="check" title="保存" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@(() => SaveRow(item))"/>
                        <RadzenButton Icon="close" title="取消" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => CancelRow(item))"/>
                    </div>
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>

@code {
    [Parameter, EditorRequired] public string ViewKey { get; set; } = string.Empty;

    private GameDataViewDefinition View = default!;
    private GameDataTableDefinition Table = default!;
    private IReadOnlyList<object> Rows = [];
    private IList<object> SelectedItems { get; set; } = [];
    private RadzenDataGrid<object>? Grid;
    private readonly Dictionary<int, string> SelectedRelations = [];
    private string? Message;
    private bool HasError;
    private IJSObjectReference? DownloadModule;
    private string LegacyViewName => View.Title;

    protected override async Task OnParametersSetAsync()
    {
        View = ViewCatalog.Get(ViewKey);
        Table = View.Tables[0];
        await LoadRows();
    }

    private async Task SelectTable(GameDataTableDefinition table)
    {
        Table = table;
        SelectedItems = [];
        await LoadRows();
    }

    private void RenderRow(RowRenderEventArgs<object> args) => args.Expandable = Table.Relations.Count > 0;

    private GameDataRelationDefinition GetSelectedRelation(int parentIndex)
    {
        if (SelectedRelations.TryGetValue(parentIndex, out string? property))
            return Table.Relations.FirstOrDefault(item => item.Property == property) ?? Table.Relations[0];
        return Table.Relations[0];
    }

    private void SelectRelation(int parentIndex, GameDataRelationDefinition relation) =>
        SelectedRelations[parentIndex] = relation.Property;

    private Task AddRow() => Grid?.InsertRow(Activator.CreateInstance(Table.ModelType)!) ?? Task.CompletedTask;
    private Task EditRow(object item) => Grid?.EditRow(item) ?? Task.CompletedTask;
    private Task SaveRow(object item) => Grid?.UpdateRow(item) ?? Task.CompletedTask;
    private void CancelRow(object item) => Grid?.CancelEditRow(item);

    private void ToggleSelection(object item)
    {
        List<object> selected = SelectedItems.ToList();
        if (!selected.Remove(item)) selected.Add(item);
        SelectedItems = selected;
    }

    private async Task CreateRow(object item) => await Run(async user =>
    {
        await DataSession.CreateAsync(Table, (MirDB.DBObject)item, user);
        await LoadRows();
        Message = "已新增并保存记录。";
    });

    private async Task UpdateRow(object item) => await Run(async user =>
    {
        await DataSession.UpdateAsync(Table, (MirDB.DBObject)item, user);
        await LoadRows();
        Message = "修改已保存。";
    });

    private async Task DeleteRow(object item)
    {
        bool? confirmed = await DialogService.Confirm("删除后将立即保存数据库，确定继续吗？", "删除记录",
            new ConfirmOptions { OkButtonText = "删除", CancelButtonText = "取消" });
        if (confirmed != true) return;
        await Run(async user =>
        {
            await DataSession.DeleteAsync(Table, ((MirDB.DBObject)item).Index, user);
            await LoadRows();
            Message = "记录已删除。";
        });
    }

    private async Task Reload()
    {
        await DataSession.ReloadAsync();
        await LoadRows();
        HasError = false;
        Message = "已重新加载。";
    }

    private async Task SaveDatabase() => await Run(async _ =>
    {
        await DataSession.SaveAndGetPathAsync();
        Message = "数据库已保存。";
    });

    private async Task InsertAfter()
    {
        MirDB.DBObject? selected = SelectedItems.OfType<MirDB.DBObject>().SingleOrDefault();
        if (selected is null) return;
        await Run(async user =>
        {
            await DataSession.InsertAfterAsync(Table, selected.Index, user);
            await LoadRows();
            Message = $"已在 #{selected.Index} 后插入记录。";
        });
    }

    private Task ExportSelected() => Export(SelectedItems.OfType<MirDB.DBObject>().Select(item => item.Index).ToArray());
    private Task ExportAll() => Export(null);

    private async Task Export(IReadOnlyCollection<int>? indices)
    {
        await Run(async _ =>
        {
            string json = await DataSession.ExportJsonAsync(Table, indices);
            DownloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/downloads.js");
            string fileName = $"{Table.ModelType.Name} - {(indices?.Count ?? Rows.Count)} - {DateTime.UtcNow:yyyy-MM-dd HH-mm-ss}.json";
            await DownloadModule.InvokeVoidAsync("downloadText", fileName, json);
            Message = $"已导出 {indices?.Count ?? Rows.Count} 行数据。";
        });
    }

    private async Task Import(InputFileChangeEventArgs args)
    {
        await Run(async user =>
        {
            await using Stream stream = args.File.OpenReadStream(32 * 1024 * 1024);
            using StreamReader reader = new(stream);
            string json = await reader.ReadToEndAsync();
            (int imported, int resolved) = await DataSession.ImportJsonAsync(Table, json, user);
            await LoadRows();
            Message = $"已导入 {imported} 行，并解析 {resolved} 个引用。";
        });
    }

    private async Task LoadRows()
    {
        Rows = await DataSession.ReadAsync(Table);
        SelectedItems = [];
        SelectedRelations.Clear();
    }

    private async Task Run(Func<string, Task> operation)
    {
        try
        {
            string user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            await operation(user);
            HasError = false;
        }
        catch (Exception ex)
        {
            HasError = true;
            Message = ex.InnerException?.Message ?? ex.Message;
            await LoadRows();
        }
    }

    private Type GetFieldType(string field) => Table.ModelType.GetProperty(field)?.PropertyType ?? typeof(string);

    private bool IsEditable(string field, Type type) => Table.ModelType.GetProperty(field)?.SetMethod?.IsPublic == true &&
                                                        (typeof(MirDB.DBObject).IsAssignableFrom(type) || IsSimple(type));

    private static bool IsSimple(Type type)
    {
        Type actual = Nullable.GetUnderlyingType(type) ?? type;
        return actual.IsPrimitive || actual.IsEnum || actual == typeof(string) || actual == typeof(decimal) || actual == typeof(DateTime) || actual == typeof(TimeSpan);
    }

    private static string ColumnWidth(GameDataColumnDefinition column, Type type) => column.Width ??
                                                                                     ((Nullable.GetUnderlyingType(type) ?? type) == typeof(string) ? "240px" : typeof(MirDB.DBObject).IsAssignableFrom(type) ? "220px" : "150px");

    private static string FormatReference(object item, string field)
    {
        MirDB.DBObject? value = item.GetType().GetProperty(field)?.GetValue(item) as MirDB.DBObject;
        return value is null ? "—" : $"{value.Index}: {value}";
    }

    private static string GetDisplayValue(object item, string field) => UiText.Value(item.GetType().GetProperty(field)?.GetValue(item));

    public async ValueTask DisposeAsync()
    {
        if (DownloadModule is not null) await DownloadModule.DisposeAsync();
    }

}
